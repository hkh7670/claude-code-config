# OS
.DS_Store

# Conversation history & runtime data (machine-specific, sensitive, huge)
projects/
sessions/
session-data/
session-env/
history.jsonl
todos/
plans/
file-history/
shell-snapshots/

# Logs
*.log
bash-commands.log
cost-tracker.log

# Caches & local state
cache/
backups/
metrics/
statsig/
mcp-needs-auth-cache.json
paste-cache/
.last-cleanup
.last-update-result.json

# Background daemon runtime state (local control keys, sockets, PIDs)
daemon/

# IDE extension connection state (contains local auth token when connected)
ide/

# Background job runtime state (session-specific; keep pins.json)
jobs/*/
jobs/.draft-*

# Plugin install state (re-installed per machine)
plugins/
.agents/
ecc/
homunculus/

# Credentials (defensive)
.credentials*
*.token
*api*key*
*.key
*.pem
*.p12
id_rsa*

# Stray editor/manual backups
*.bak
*_backup
*.orig
